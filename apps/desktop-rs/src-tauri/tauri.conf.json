{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZCode",
  "version": "0.1.0",
  "identifier": "com.zcode.desktop-rs",
  "build": {
    "beforeDevCommand": "cd frontend && npm run css:build && trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd frontend && npm run css:build && trunk build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZCode",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
